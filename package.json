{
  "name": "cs2-lineup-overlay",
  "version": "1.0.0",
  "description": "Always-on-top CS2 lineup helper overlay with automatic map detection via Game State Integration.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.cs2lineupoverlay.app",
    "productName": "CS2 Lineup Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "asarUnpack": [
      "data/**/*",
      "images/**/*",
      "gsi/**/*",
      "PRIVACY.md",
      "ads-config.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "Esor48",
      "repo": "easy-line-up"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "build/PRIVACY-AND-LICENSE.txt",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
